
	import java.util.Random;
	import java.util.Scanner;

	public class StopAndWaitProtocol {
	    public static void main(String[] args) {
	        Scanner sc = new Scanner(System.in);
	        Random rand = new Random();

	        System.out.print("Enter number of frames to send: ");
	        int n = sc.nextInt();

	        System.out.println("\n--- Stop and Wait Protocol Simulation ---\n");

	        for (int i = 0; i < n; i++) {
	            System.out.println("Sender: Sending Frame " + i);

	            // Simulate random loss (0 = lost, 1 = success)
	            int success = rand.nextInt(2);

	            if (success == 0) {
	                System.out.println("Receiver: Frame " + i + " lost! (No ACK sent)");
	                System.out.println("Sender: Timeout! Resending Frame " + i + "...");
	                System.out.println("Receiver: Frame " + i + " received successfully. Sending ACK " + i + "\n");
	            } else {
	                System.out.println("Receiver: Frame " + i + " received successfully. Sending ACK " + i + "\n");
	            }
	        }

	        System.out.println("All frames transmitted successfully!\n");
	        sc.close();
	    }
	}
